generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPPORT
  OPERATIONS
  APPROVER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  CLOSED
}

enum TransactionStatus {
  FLAGGED
  APPROVED
  REJECTED
  ESCALATED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  PENDING
}

enum ApprovalAction {
  APPROVE
  REJECT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  VETOED
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
}

model Customer {
  id              String        @id
  name            String
  accountLastFour String
  accountStatus   AccountStatus
  riskLevel       RiskLevel
  createdAt       DateTime      @default(now())
  transactions    Transaction[]
}

model Transaction {
  id               String            @id
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  merchant         String
  amountMinor      Int
  currency         String
  paymentMethod    String
  riskLevel        RiskLevel
  flagReason       String
  status           TransactionStatus @default(FLAGGED)
  createdAt        DateTime
  updatedAt        DateTime          @updatedAt
  approvalRequests ApprovalRequest[]

  @@index([status, riskLevel])
  @@index([customerId])
  @@index([merchant])
}

model AuditEvent {
  id            String             @id
  actorId       String
  actorName     String
  actorRole     Role
  action        String
  resourceType  String
  resourceId    String
  previousState TransactionStatus?
  newState      TransactionStatus?
  reason        String?
  outcome       AuditOutcome
  createdAt     DateTime           @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
}

model ApprovalRequest {
  id                   String            @id
  transactionId        String
  transaction          Transaction       @relation(fields: [transactionId], references: [id])
  requestedAction      ApprovalAction
  requestedTargetState TransactionStatus
  requestedById        String
  requestedByName      String
  requestedByRole      Role
  requestReason        String
  status               ApprovalStatus    @default(PENDING)
  activeTransactionId  String?           @unique
  reviewedById         String?
  reviewedByName       String?
  reviewedByRole       Role?
  reviewReason         String?
  createdAt            DateTime          @default(now())
  reviewedAt           DateTime?

  @@index([transactionId, status])
  @@index([status, createdAt])
}
