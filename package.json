{
  "name": "transaction-risk-operations-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:prepare && vitest run",
    "test:coverage": "npm run test:prepare && vitest run --coverage",
    "test:prepare": "DATABASE_URL=file:./test.db prisma db push --force-reset --skip-generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.9",
    "postcss": "8.5.10",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
